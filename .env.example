# ----------------------------------------------------------------------------
# Scanner — конфигурация. Скопируйте в .env: cp .env.example .env
# Затем обязательно замените секреты, помеченные CHANGE_ME, и запустите:
#   docker compose up --build
# ----------------------------------------------------------------------------

# --- PostgreSQL (контейнер db) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=scanner
POSTGRES_USER=scanner
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- Режим ---
# production задаёт docker-compose.prod.yml: с пустыми или шаблонными (CHANGE_ME)
# секретами app не стартует. Вне production — только предупреждения в логе.
# SCANNER_ENV=production
# Сколько раз по 2 с ждать БД при старте app, прежде чем остановиться с ошибкой.
# SCANNER_DB_WAIT_ATTEMPTS=30

# --- Порты на хосте ---
# Если на машине уже заняты 8080/8000/5432 (другие контейнеры или службы),
# задайте свободные. Внутри контейнеров порты не меняются.
# Веб-интерфейс открыт для сети; API и БД слушают только localhost хоста.
SCANNER_WEB_PORT=8080
SCANNER_API_PORT=8000
SCANNER_DB_PORT=5432

# --- API: токены и первый администратор ---
# Ключ подписи токенов доступа. Не менее 32 символов. Если пусто — ключ
# генерируется при старте и токены «слетают» после перезапуска, поэтому в
# реальной установке задайте его явно (напр. `openssl rand -base64 48`).
SCANNER_API_SECRET=CHANGE_ME_token_signing_secret_min_32_chars

# Первый администратор создаётся при первом старте, пока в БД нет пользователей.
# Пароль — не короче 12 символов. После первого старта переменные можно убрать.
SCANNER_API_BOOTSTRAP_ADMIN=admin
SCANNER_API_BOOTSTRAP_PASSWORD=CHANGE_ME_admin_password_min_12

# Проверка доступности хоста из веб-интерфейса: не больше N проверок
# на пользователя в минуту (только цели из allowlist договора).
SCANNER_API_REACHABILITY_PER_MINUTE=10

# Проверка входа по учётным записям из «Активов» (без сканирования): хостов на
# пользователя в минуту и сколько хостов проверяется одновременно.
SCANNER_API_CREDENTIAL_CHECK_HOSTS_PER_MINUTE=120
SCANNER_API_CREDENTIAL_CHECK_WORKERS=4
# Проверка сетевой доступности (вкладка «Доступность»): запусков на пользователя
# в минуту, одновременных заданий у пользователя, адресов в задании, параллельных заданий.
SCANNER_API_PORTSCAN_PER_MINUTE=6
SCANNER_API_PORTSCAN_MAX_ACTIVE=2
SCANNER_API_PORTSCAN_MAX_TARGETS=1024
SCANNER_API_PORTSCAN_WORKERS=2

# Прогоны по расписанию: часовой пояс по умолчанию (если браузер оператора
# не прислал свой) и как часто планировщик проверяет, не пора ли (секунды;
# 0 — выключить планировщик).
SCANNER_API_TIMEZONE=Europe/Moscow
SCANNER_API_SCHEDULER_TICK_SECONDS=30

# Восстановление после сбоя: как часто отмечать «жив» у своих прогонов и искать
# прогоны, оставшиеся от упавшего процесса (секунды; 0 — только при старте), и
# через сколько секунд без отметки прогон считается осиротевшим.
# SCANNER_API_RUN_HEARTBEAT_SECONDS=30
# SCANNER_API_RUN_STALE_SECONDS=180

# --- Уведомления (почта, Telegram, syslog/CEF, Jira): настройка каналов — в
# веб-интерфейсе, раздел «Уведомления». Внешний адрес интерфейса — для ссылки на
# отчёт в сообщениях; период просмотра очереди повторов, секунды (0 — выключить).
# SCANNER_API_PUBLIC_URL=https://scanner.corp.local
# SCANNER_API_NOTIFY_TICK_SECONDS=30

# --- Учётные записи активов (поиск уязвимостей по учётной записи, SSH) ---
# Ключ шифрования паролей и ключей SSH в БД, не короче 16 символов.
# Пусто — используется SCANNER_API_SECRET. Задайте отдельно и сохраните:
# при смене ключа сохранённые учётки не расшифруются, их придётся завести
# заново. Сгенерировать: openssl rand -base64 48
SCANNER_CREDENTIALS_KEY=
# Ключи хостов запоминаются при первом входе (каталог ./data на хосте).
# SCANNER_SSH_STRICT_HOST_KEYS=1 — входить только на хосты, чей ключ уже в файле.
SCANNER_SSH_KNOWN_HOSTS=/data/ssh_known_hosts
SCANNER_SSH_STRICT_HOST_KEYS=0
# Перед входом по SSH: проверка TCP-порта и баннера SSH (0 — выключить) и
# число попыток при таймауте. Не дождались — прогон «Частично», причина в
# «Полноте проверки».
SCANNER_SSH_PREFLIGHT=1
SCANNER_SSH_ATTEMPTS=2
SCANNER_SSH_RETRY_DELAY_SEC=3

# --- Аудит конфигураций по учётной записи (OpenSCAP + Lynis) ---
# Каталог контента SCAP Security Guide (ssg-*-ds.xml); свой — в ./data/ssg.
SCANNER_CONFIG_AUDIT_SCAP_DIR=/usr/share/xml/scap/ssg/content
# Свой datastream для всех хостов (например, профиль ФСТЭК) и профиль XCCDF.
# Пусто — datastream SSG по ОС хоста и профиль CIS уровня 1 / standard.
SCANNER_CONFIG_AUDIT_SCAP_CONTENT=
SCANNER_CONFIG_AUDIT_SCAP_PROFILE=
# Предел времени одной проверки на хосте, секунды.
SCANNER_CONFIG_AUDIT_COMMAND_TIMEOUT_SEC=1800

# --- Аудит Windows по WinRM (учётки protocol=winrm) ---
# Проверка сертификата WinRM: pin — запоминать отпечаток при первом входе (TOFU),
# ca — проверять цепочку по SCANNER_WINRM_CA_BUNDLE.
SCANNER_WINRM_TLS=pin
SCANNER_WINRM_KNOWN_CERTS=/data/winrm_known_certs
# 1 — входить только на хосты с уже известным сертификатом (заполнить заранее).
SCANNER_WINRM_STRICT_CERTS=0
SCANNER_WINRM_CA_BUNDLE=
# 1 — разрешить WinRM по HTTP (5985); по умолчанию только HTTPS (5986).
SCANNER_WINRM_ALLOW_HTTP=0

# --- Справочники уязвимостей ---
# Положите выгрузку БДУ ФСТЭК (vullist.xlsx) в каталог ./data и укажите путь
# внутри контейнера. entrypoint загрузит её один раз при первом старте.
BDU_FSTEC_FEED_PATH=/data/vullist.xlsx
SCANNER_BDU_AUTOLOAD=1

# Обновлять шаблоны Nuclei при старте (нужна сеть). 0 — выключить.
SCANNER_NUCLEI_UPDATE=1

# Ключ NVD API 2.0 (необязателен; ускоряет загрузку CVE). Загрузка:
#   docker compose exec app scanner feeds sync-nvd
NVD_API_KEY=

# Автообновление справочников по расписанию настраивается в вебе: «Справочники».
# БДУ можно скачивать по адресу (пусто — берётся файл BDU_FSTEC_FEED_PATH).
BDU_FSTEC_FEED_URL=
# Приоритизация риска: пути к файлам вместо скачивания (закрытый контур)
EPSS_FEED_PATH=
KEV_FEED_PATH=

# Обновления Microsoft (MSRC) — аудит Windows по учётной записи.
# Пусто — загрузка через API MSRC; путь к файлу/каталогу CVRF *.json — закрытый
# контур. Загрузка: «Справочники» → «Обновления Microsoft» или
#   docker compose exec app scanner feeds sync-msrc
SCANNER_MSRC_FEED_PATH=
SCANNER_MSRC_SINCE=2019-Jan

# Бюллетени дистрибутивов — учёт бэкпортов в поиске по учётной записи.
# Какие выпуски загружать (семейство:выпуск через запятую; семейства debian,
# ubuntu, rhel — он же для CentOS/Rocky/Alma/Oracle, alt, astra, redos, alpine).
# Выпуски ОС, встреченные на хостах, добавляются сами (подгрузка в прогоне,
# дальше — по расписанию), так что список можно не дополнять.
# Загрузка: «Справочники» → «Бюллетени дистрибутивов» или
#   docker compose exec app scanner feeds sync-advisories
ADVISORY_RELEASES=debian:bullseye,debian:bookworm,ubuntu:focal,ubuntu:jammy,ubuntu:noble,rhel:8,rhel:9,alt:p10
# Закрытый контур: файлы вендоров в ./data/advisories (debian.json[.gz],
# ubuntu-jammy.xml.bz2, rhel-9.xml.bz2, astra-1.7.xml, redos-7.3.xml …)
# главнее адресов. Astra Linux — каталог al-oval на dl.astralinux.ru (файл
# выпуска ищется по оглавлению), РЕД ОС — redos.xml (один на все выпуски).
ADVISORY_DIR=/data/advisories
# Свой адрес выгрузки ({release} подставляется), напр. зеркало в контуре.
ADVISORY_URL_ASTRA=
ADVISORY_URL_REDOS=
# Подгрузка бюллетеней выпусков ОС хостов прямо в прогоне:
#   auto — файл из ADVISORY_DIR всегда, из интернета — только если в «Справочниках»
#          включено автообновление «Бюллетени дистрибутивов»; 1 — всегда; 0 — выкл.
ADVISORY_ON_DEMAND=auto

# Комплект данных уязвимостей (снимок NVD, БДУ, EPSS, KEV, MSRC, бюллетеней ОС и
# шаблонов Nuclei одним файлом): положите scanner-data-<дата>.tar в ./data/bundle —
# при первом старте справочники загрузятся из него, а дальше автообновление
# докачивает только изменения. Либо адрес, откуда скачать комплект, если в
# ./data/bundle его нет (например, файл релиза data-<дата>). 0 — не загружать.
SCANNER_BUNDLE_AUTOLOAD=1
SCANNER_DATA_BUNDLE_URL=

# Профиль интенсивности по умолчанию: gentle | normal | aggressive
DEFAULT_RATE_PROFILE=gentle
