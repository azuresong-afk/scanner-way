<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ r.context.title }}</title>
<style>
  :root {
    --ink: #101828; --ink-2: #344054; --muted: #667085; --faint: #98a2b3;
    --line: #eaecf0; --bg: #ffffff; --panel: #f9fafb; --accent: #1d2b4f; --accent-2: #3e4c7a;
    --critical: {{ SEVERITY_HEX.critical }}; --high: {{ SEVERITY_HEX.high }};
    --medium: {{ SEVERITY_HEX.medium }}; --low: {{ SEVERITY_HEX.low }}; --info: {{ SEVERITY_HEX.info }};
    --good: #067647; --good-bg: #ecfdf3;
  }
  @page { size: A4; margin: 20mm 16mm 18mm 16mm;
          @top-left { content: string(doctitle); font-family: Inter, "DejaVu Sans", sans-serif;
                      font-size: 7.5pt; color: #98a2b3; }
          @top-right { content: string(customer); font-family: Inter, "DejaVu Sans", sans-serif;
                       font-size: 7.5pt; color: #98a2b3; }
          @bottom-right { content: counter(page) " / " counter(pages);
                          font-family: Inter, "DejaVu Sans", sans-serif; font-size: 7.5pt;
                          color: #98a2b3; } }
  @page cover { margin: 0; @top-left { content: none; } @top-right { content: none; }
                @bottom-right { content: none; } }
  * { box-sizing: border-box; }
  body { font-family: Inter, "DejaVu Sans", "Segoe UI", Arial, sans-serif; color: var(--ink-2);
         background: var(--bg); margin: 0 auto; max-width: 1100px; padding: 24px 16px 48px;
         font-size: 9.5pt; line-height: 1.5; }
  @media print { body { padding: 0; max-width: none; } }
  h1, h2, h3, h4 { color: var(--ink); font-weight: 600; }
  a { color: var(--accent-2); word-break: break-all; text-decoration: none; }
  .muted { color: var(--muted); }
  .zero { color: var(--faint); }

  /* --- обложка ---------------------------------------------------------------- */
  .cover { background: var(--accent); color: #fff; border-radius: 14px; padding: 36px 36px 30px;
           margin-bottom: 28px; }
  .cover .kicker { text-transform: uppercase; letter-spacing: .14em; font-size: 7.5pt;
                   color: rgba(255,255,255,.7); font-weight: 600; }
  .cover h1 { color: #fff; font-size: 24pt; line-height: 1.2; margin: 10px 0 18px;
              font-weight: 700; letter-spacing: -.01em; string-set: doctitle content(); }
  .cover .customer { font-size: 12pt; color: #fff; font-weight: 600; string-set: customer content(); }
  .cover .meta { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 14px;
                 font-size: 8.5pt; color: rgba(255,255,255,.75); }
  .cover .meta b { color: #fff; font-weight: 600; }
  .cover .score { display: flex; gap: 10px; margin-top: 26px; flex-wrap: wrap; }
  .cover .score div { flex: 1 1 110px; background: rgba(255,255,255,.08); border-radius: 10px;
                      padding: 10px 14px; }
  .cover .score small { display: block; font-size: 7pt; letter-spacing: .1em;
                        text-transform: uppercase; color: rgba(255,255,255,.65); }
  .cover .score b { display: block; font-size: 17pt; color: #fff; font-weight: 600; margin-top: 2px; }
  .cover .score div.risk { border-top: 3px solid; }
  .cover .legal { margin-top: 26px; font-size: 7.5pt; color: rgba(255,255,255,.55); }
  @media print {
    .cover { page: cover; border-radius: 0; margin: 0; padding: 70mm 22mm 0; height: 297mm;
             page-break-after: always; }
    .cover h1 { font-size: 30pt; }
    .cover .legal { position: absolute; bottom: 18mm; left: 22mm; right: 22mm; }
  }

  /* --- заголовки разделов --------------------------------------------------- */
  h2 { font-size: 15pt; margin: 34px 0 14px; padding-bottom: 8px; border-bottom: 1px solid var(--line);
       page-break-after: avoid; letter-spacing: -.005em; }
  h2 .n { color: var(--accent-2); font-weight: 500; margin-right: 8px; font-size: 11pt;
          vertical-align: 2px; }
  h3 { font-size: 11pt; margin: 22px 0 10px; page-break-after: avoid; }
  .lead { color: var(--muted); margin: -4px 0 14px; page-break-after: avoid; }

  /* --- плитки и карточки ---------------------------------------------------- */
  .kpis { display: flex; flex-wrap: wrap; gap: 10px; margin: 6px 0 12px; }
  .kpi { flex: 1 1 120px; border: 1px solid var(--line); border-radius: 10px;
         padding: 11px 14px; background: var(--bg); page-break-inside: avoid; }
  .kpi small { display: block; color: var(--muted); font-size: 7pt; font-weight: 600;
               letter-spacing: .08em; text-transform: uppercase; }
  .kpi b { display: block; font-size: 20pt; line-height: 1.2; margin-top: 4px; color: var(--ink);
           font-weight: 600; letter-spacing: -.01em; }
  .kpi .sub { font-size: 8pt; color: var(--muted); }
  .kpi.risk { border-top: 3px solid var(--faint); }
  .kpi.risk-critical { border-top-color: var(--critical); } .kpi.risk-critical b { color: var(--critical); }
  .kpi.risk-high { border-top-color: var(--high); } .kpi.risk-high b { color: #c4320a; }
  .kpi.risk-medium { border-top-color: var(--medium); } .kpi.risk-medium b { color: #b54708; }
  .kpi.risk-low { border-top-color: var(--low); } .kpi.risk-low b { color: var(--low); }
  .kpi.risk-none { border-top-color: var(--good); } .kpi.risk-none b { color: var(--good); }
  .up { color: #c4320a; font-weight: 600; } .down { color: var(--good); font-weight: 600; }
  .cards { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 12px; }
  .card { flex: 1 1 300px; border: 1px solid var(--line); border-radius: 10px;
          padding: 12px 14px 10px; page-break-inside: avoid; background: var(--bg); }
  .card h4 { margin: 0 0 8px; font-size: 7.5pt; letter-spacing: .08em; text-transform: uppercase;
             color: var(--muted); }
  svg.chart { display: block; width: 100%; height: auto; max-width: 460px; margin: 0 auto; }
  svg.chart[data-chart="modules"] { max-width: 820px; }
  .points { margin: 4px 0 0; padding: 0; list-style: none; }
  .points li { position: relative; padding: 7px 0 7px 18px; border-bottom: 1px solid var(--line); }
  .points li:last-child { border-bottom: none; }
  .points li::before { content: ""; position: absolute; left: 2px; top: 13px; width: 6px; height: 6px;
                       border-radius: 50%; background: var(--accent-2); }

  /* --- метки уровня опасности и статуса ------------------------------------- */
  .sev { display: inline-block; padding: 1px 8px 1px 7px; border-radius: 10px; font-size: 7.5pt;
         font-weight: 600; white-space: nowrap; line-height: 1.6; }
  .sev::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%;
                 margin-right: 5px; vertical-align: 1px; background: currentColor; }
  .sev-critical { background: #fef3f2; color: #b42318; }
  .sev-high { background: #fff4ed; color: #c4320a; }
  .sev-medium { background: #fffaeb; color: #b54708; }
  .sev-low { background: #eff8ff; color: #175cd3; }
  .sev-info { background: #f2f4f7; color: #475467; }
  .status { font-size: 7.5pt; color: var(--muted); white-space: nowrap; font-weight: 500; }
  .status-new, .status-regression { color: #c4320a; }
  .status-fixed { color: var(--good); }

  /* --- таблицы -------------------------------------------------------------- */
  table { width: 100%; border-collapse: collapse; margin: 6px 0 14px; }
  th { text-align: left; font-size: 7pt; font-weight: 600; letter-spacing: .06em;
       text-transform: uppercase; color: var(--muted); padding: 7px 8px;
       border-bottom: 1px solid var(--line); background: var(--panel); }
  td { padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  tr { page-break-inside: avoid; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  td.total { font-weight: 600; color: var(--ink); }
  .wrap { overflow-x: auto; }
  @media print { .wrap table { font-size: 8.5pt; } }
  td.idx { color: var(--faint); width: 22px; }
  .plan td.action b { color: var(--ink); font-weight: 600; }
  .plan .src { display: block; color: var(--muted); font-size: 8pt; margin-top: 2px; }
  .mono { font-family: "DejaVu Sans Mono", Menlo, Consolas, monospace; font-size: 8pt; }
  .ids { color: var(--muted); font-size: 8pt; }

  /* --- раздел по хостам ----------------------------------------------------- */
  .host { border: 1px solid var(--line); border-radius: 10px; margin: 0 0 14px;
          page-break-inside: avoid; }
  .host table { table-layout: fixed; }
  .host td { word-wrap: break-word; overflow-wrap: anywhere; }
  .host .status { white-space: normal; }
  .host .ids a { white-space: nowrap; overflow-wrap: normal; }
  .host-head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px;
               padding: 10px 14px; background: var(--panel); border-radius: 10px 10px 0 0;
               border-bottom: 1px solid var(--line); page-break-after: avoid; }
  .host-head .name { font-size: 11pt; font-weight: 600; color: var(--ink); }
  .host-head .facts { color: var(--muted); font-size: 8pt; flex: 1 1 auto; }
  .host-head .counts { display: flex; gap: 4px; }
  .host table { margin: 0; }
  .host td:first-child, .host th:first-child { padding-left: 14px; }
  .host td:last-child, .host th:last-child { padding-right: 14px; }
  .host tr:last-child td { border-bottom: none; }
  .host th { background: var(--bg); }
  .strip { display: flex; height: 6px; width: 100%; border-radius: 3px; overflow: hidden;
           background: var(--line); }
  .strip span { display: block; height: 6px; border-right: 2px solid #fff; }
  .strip span:last-child { border-right: none; }

  /* --- карточки находок ----------------------------------------------------- */
  .finding { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px;
             margin: 0 0 10px; page-break-inside: avoid; }
  .finding h4 { margin: 0 0 6px; font-size: 10pt; line-height: 1.4; }
  .kv { display: flex; flex-wrap: wrap; gap: 4px 16px; color: var(--muted); font-size: 8pt;
        margin-bottom: 6px; }
  .kv b { color: var(--ink-2); font-weight: 600; }
  pre { white-space: pre-wrap; word-break: break-word; background: var(--panel);
        border: 1px solid var(--line); padding: 7px 9px; font-size: 7.5pt; margin: 6px 0 0;
        border-radius: 6px; font-family: "DejaVu Sans Mono", Menlo, Consolas, monospace; }
  .fix { background: var(--good-bg); border-radius: 8px; padding: 8px 11px; margin-top: 8px; }
  .fix .label { color: var(--good); font-weight: 600; font-size: 7pt; letter-spacing: .08em;
                text-transform: uppercase; display: block; margin-bottom: 2px; }
  .fix .src { color: var(--muted); font-size: 7.5pt; display: block; margin-top: 4px; }
  .refs { margin-top: 8px; padding-top: 6px; border-top: 1px solid #d1fadf; }
  .refs .label { color: var(--good); font-weight: 600; font-size: 7pt; letter-spacing: .08em;
                 text-transform: uppercase; display: block; margin-bottom: 2px; }
  .refs ol { margin: 0; padding-left: 18px; font-size: 8pt; }
  .refs li { margin: 1px 0; }
  .refs li b, .brief-refs li b { color: var(--ink-2); font-weight: 600; margin-right: 4px; }
  .brief-refs { margin: 0; padding-left: 18px; font-size: 8pt; }
  .brief-refs li { margin: 1px 0; }
  .verdict { padding: 10px 14px; border-radius: 10px; background: var(--panel);
             border: 1px solid var(--line); color: var(--ink); font-weight: 600; margin: 0 0 12px; }
  .footer-note { color: var(--muted); font-size: 8pt; margin-top: 28px; padding-top: 10px;
                 border-top: 1px solid var(--line); }
</style>
</head>
<body>
{% macro sev(s) %}<span class="sev sev-{{ s }}">{{ SEVERITY_LABELS[s] }}</span>{% endmacro %}
{% macro n(v) %}<td class="num{% if not v %} zero{% endif %}">{{ v }}</td>{% endmacro %}
{% macro strip(counts) %}{% set total = counts.values()|sum %}<div class="strip">{% if total %}{% for s in SEVERITY_ORDER if counts[s] %}<span style="width: {{ '%.2f'|format(100 * counts[s] / total) }}%; background: {{ SEVERITY_HEX[s] }}" title="{{ SEVERITY_LABELS[s] }}: {{ counts[s] }}"></span>{% endfor %}{% endif %}</div>{% endmacro %}
{% set sc = r.summary.severity_counts %}
{% set t = r.combined.trend %}

<section class="cover">
  <div class="kicker">Анализ защищённости · результаты сканирования{% if r.brief %} · краткая версия{% endif %}</div>
  <h1>{{ r.context.title }}</h1>
  {% if r.context.customer %}<div class="customer">{{ r.context.customer }}</div>{% endif %}
  <div class="meta">
    {% if r.context.engagement %}<span>Договор / проект: <b>{{ r.context.engagement }}</b></span>{% endif %}
    {% if r.context.run_id is not none %}<span>Прогон: <b>{{ r.context.run_id }}</b></span>{% endif %}
    {% if r.context.previous_run_id is not none %}<span>Сравнение с прогоном: <b>{{ r.context.previous_run_id }}</b></span>{% endif %}
    <span>Сформирован: <b>{{ r.context.generated_at.strftime("%d.%m.%Y %H:%M UTC") }}</b></span>
  </div>
  <div class="score">
    <div class="risk" style="border-top-color: {{ SEVERITY_HEX[r.summary.risk_level] if r.summary.risk_level else '#12b76a' }}"><small>Уровень риска</small><b>{{ r.summary.risk_label }}</b></div>
    <div><small>Хостов с находками</small><b>{{ r.summary.hosts }}</b></div>
    <div><small>Всего находок</small><b>{{ r.summary.total }}</b></div>
    <div><small>Критических и высоких</small><b>{{ sc.critical + sc.high }}</b></div>
  </div>
  <div class="legal">Конфиденциально. Отчёт сформирован по результатам авторизованного тестирования
  в рамках договора и предназначен только для заказчика.</div>
</section>

<h2><span class="n">{{ "%02d"|format(num.summary) }}</span>Резюме для руководства</h2>
<div class="dashboard">
<div class="kpis">
  <div class="kpi risk risk-{{ r.summary.risk_level or 'none' }}">
    <small>Общий уровень риска</small><b>{{ r.summary.risk_label }}</b>
    <span class="sub">по наиболее опасной находке</span>
  </div>
  <div class="kpi"><small>Всего находок</small><b>{{ r.summary.total }}</b>
    {% if t %}{% set prev_total = t.severity|sum(attribute="previous") %}{% set dlt = r.summary.total - prev_total %}
    <span class="sub"><span class="{% if dlt > 0 %}up{% elif dlt < 0 %}down{% endif %}">{{ "%+d"|format(dlt) if dlt else "±0" }}</span> к прошлому прогону</span>
    {% else %}<span class="sub">первый прогон</span>{% endif %}
  </div>
  <div class="kpi"><small>Критических и высоких</small><b>{{ sc.critical + sc.high }}</b>
    <span class="sub">устранять в первую очередь</span></div>
  <div class="kpi"><small>Хостов с находками</small><b>{{ r.summary.hosts }}</b>
    <span class="sub">{% if r.brief %}по всем модулям сканирования{% else %}мер в плане устранения: {{ r.plan|length }}{% endif %}</span></div>
  {% if t %}
  <div class="kpi"><small>Новые / повторные</small><b>{{ t.counts.new }} / {{ t.counts.regression }}</b>
    <span class="sub">устранено: <span class="down">{{ t.counts.fixed }}</span></span></div>
  {% endif %}
</div>

<div class="cards">
  <div class="card">
    <h4>Распределение по уровню опасности</h4>
    {{ charts.severity }}
  </div>
  {% if charts.hosts %}
  <div class="card">
    <h4>Наиболее уязвимые хосты</h4>
    {{ charts.hosts }}
  </div>
  {% endif %}
</div>
</div>

<h3>Ключевые выводы</h3>
<ul class="points">
  {% for p in r.summary.key_points %}<li>{{ p }}</li>{% endfor %}
</ul>

<h3>Находки по модулям</h3>
{% if charts.modules %}<div class="card">{{ charts.modules }}</div>{% endif %}
<div class="wrap"><table>
  <tr><th>Модуль</th>{% for s in SEVERITY_ORDER %}<th class="num">{{ SEVERITY_LABELS[s] }}</th>{% endfor %}<th class="num">Всего</th></tr>
  {% for m in r.modules %}
  <tr><td>{{ m.label }}</td>{% for s in SEVERITY_ORDER %}{{ n(m.severity_counts[s]) }}{% endfor %}<td class="num total">{{ m.findings|length }}</td></tr>
  {% endfor %}
</table></div>

{% if not r.brief %}
<h2><span class="n">{{ "%02d"|format(num.plan) }}</span>План устранения</h2>
{% if r.plan %}
<p class="lead">Одинаковые меры объединены: одна строка — одно действие и все хосты, где его нужно выполнить.
Порядок — по уровню опасности и числу затронутых хостов.</p>
<div class="wrap"><table class="plan">
  <tr><th></th><th>Опасность</th><th>Что сделать</th><th>Где</th></tr>
  {% for p in r.plan %}
  <tr>
    <td class="idx">{{ loop.index }}</td>
    <td>{{ sev(p.severity) }}</td>
    <td class="action"><b>{{ p.action }}</b><span class="src">Источник: {{ p.source_label }} · {{ p.titles|join("; ") }}</span>
      {% if p.references %}<span class="src">{% for ref in p.references|links(4) %}<a href="{{ ref.url }}">{{ ref.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</span>{% endif %}</td>
    <td class="mono">{{ p.targets|join(", ") }}</td>
  </tr>
  {% endfor %}
</table></div>
{% else %}
<p>Мер устранения не требуется.</p>
{% endif %}
{% endif %}

<h2><span class="n">{{ "%02d"|format(num.trend) }}</span>Сравнение с предыдущим прогоном</h2>
{% if t %}
<div class="verdict">{{ t.verdict }}</div>
<div class="kpis">
  {% for st in STATUS_ORDER %}
  <div class="kpi"><small>{{ STATUS_LABELS[st] }}</small><b class="status-{{ st }}">{{ t.counts[st] }}</b></div>
  {% endfor %}
</div>
<div class="cards">
  <div class="card">
    <h4>Что изменилось с прошлого прогона</h4>
    {{ charts.waterfall }}
  </div>
  <div class="card">
    <h4>Число находок по прогонам</h4>
    {{ charts.trend }}
  </div>
</div>
<table>
  <tr><th>Уровень опасности</th><th class="num">Предыдущий прогон</th><th class="num">Текущий прогон</th><th class="num">Изменение</th></tr>
  {% for d in t.severity %}
  <tr><td>{{ sev(d.severity) }}</td>{{ n(d.previous) }}{{ n(d.current) }}
      <td class="num {% if d.delta > 0 %}up{% elif d.delta < 0 %}down{% else %}zero{% endif %}">{{ "%+d"|format(d.delta) if d.delta else "0" }}</td></tr>
  {% endfor %}
</table>
<h3>Динамика по модулям</h3>
<div class="wrap"><table>
  <tr><th>Модуль</th>{% for st in STATUS_ORDER %}<th class="num">{{ STATUS_LABELS[st] }}</th>{% endfor %}</tr>
  {% for m in r.modules if m.trend %}
  <tr><td>{{ m.label }}</td>{% for st in STATUS_ORDER %}{{ n(m.trend.counts[st]) }}{% endfor %}</tr>
  {% endfor %}
</table></div>
{% if t.fixed %}
<h3>Устранено с предыдущего прогона</h3>
<table>
  <tr><th>Опасность</th><th>Находка</th><th>Хост</th></tr>
  {% for v in t.fixed %}
  <tr><td>{{ sev(v.finding.severity) }}</td><td>{{ v.finding.title }}</td><td class="mono">{{ v.target }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% else %}
<p>Предыдущий прогон не задан — это первый прогон, сравнение будет доступно со следующего.</p>
{% endif %}

<h2><span class="n">{{ "%02d"|format(num.hosts) }}</span>Результаты по хостам</h2>
{% if hosts %}
<p class="lead">Все находки по каждому хосту. Хосты упорядочены по уровню риска.</p>
{% for h in hosts %}
<div class="host" id="host-{{ loop.index }}">
  <div class="host-head">
    <span class="name mono">{{ h.host }}</span>
    {% if h.risk %}{{ sev(h.risk) }}{% endif %}
    <span class="facts">Находок: {{ h.total }}{% if h.ports %} · Порты: {{ h.ports|join(", ") }}{% endif %}</span>
    <div style="flex: 1 1 100%">{{ strip(h.counts) }}</div>
  </div>
  <table>
    <colgroup><col style="width: 20%"><col style="width: {{ 28 if t else 43 }}%"><col style="width: 7%"><col style="width: 22%"><col style="width: 8%">{% if t %}<col style="width: 15%">{% endif %}</colgroup>
    <tr><th>Опасность</th><th>Находка</th><th>Порт</th><th>Идентификаторы</th><th class="num">CVSS</th>{% if t %}<th>Статус</th>{% endif %}</tr>
    {% for v in h.findings %}
    {% set f = v.finding %}
    <tr>
      <td>{{ sev(f.severity) }}</td>
      <td>{{ f.title }}<div class="ids">{{ v.module_label }}</div>
        {% if v.remediation.references %}<div class="ids">Устранение: {% for ref in v.remediation.references|links(2) %}<a href="{{ ref.url }}">{{ ref.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}</td>
      <td class="mono">{{ f.port if f.port is not none else "—" }}</td>
      <td class="ids">{% for c in f.cve_ids %}{{ c }}<br>{% endfor %}{% for b in f.bdu_ids %}{{ b }}<br>{% endfor %}{% if not f.cve_ids and not f.bdu_ids %}{{ f.vuln_id or "—" }}{% endif %}</td>
      <td class="num">{{ "%.1f"|format(f.cvss) if f.cvss is not none else "—" }}</td>
      {% if t %}<td><span class="status status-{{ v.status }}">{{ v.status_label or "" }}</span></td>{% endif %}
    </tr>
    {% endfor %}
  </table>
</div>
{% endfor %}
{% else %}
<p>Находок нет.</p>
{% endif %}

<h2><span class="n">{{ "%02d"|format(num.details) }}</span>Детальные результаты для инженеров</h2>
<p class="lead">Описание каждой находки с подтверждением и {{ "ссылками на устранение" if r.brief else "рекомендацией по устранению" }}, по модулям сканирования.</p>
{% for m in r.modules %}
<h3>{{ num.details }}.{{ loop.index }}. {{ m.label }}</h3>
{% if not m.findings %}<p class="muted">Открытых находок нет.</p>{% endif %}
{% for s, label, group in m.by_severity %}
  {% for v in group %}
  {% set f = v.finding %}
  <div class="finding">
    <h4>{{ sev(f.severity) }} {{ f.title }}
      {% if v.status %}<span class="status status-{{ v.status }}">· {{ v.status_label }}</span>{% endif %}</h4>
    <div class="kv">
      <span>Хост <b class="mono">{{ v.target }}</b></span>
      {% if f.vuln_id %}<span>ID <b>{{ f.vuln_id }}</b></span>{% endif %}
      {% if f.cvss is not none %}<span>CVSS <b>{{ "%.1f"|format(f.cvss) }}</b></span>{% endif %}
      {% if f.cve_ids %}<span>CVE <b>{{ f.cve_ids|join(", ") }}</b></span>{% endif %}
      {% if f.bdu_ids %}<span>БДУ <b>{{ f.bdu_ids|join(", ") }}</b></span>{% endif %}
    </div>
    {% if f.evidence %}<pre>{{ f.evidence }}</pre>{% endif %}
    {% if r.brief %}
    <div class="fix">
      <span class="label">Ссылки на устранение</span>
      {% set refs = v.remediation.references|links %}
      {% if refs %}<ol class="brief-refs">{% for ref in refs %}<li><b>{{ ref.label }}</b> <a href="{{ ref.url }}">{{ ref.url }}</a></li>{% endfor %}</ol>
      {% else %}<span class="src">Ссылок на устранение нет.</span>{% endif %}
    </div>
    {% else %}
    <div class="fix">
      <span class="label">Рекомендация по устранению</span>
      {{ v.remediation.text }}
      {% if v.remediation.fix_method %}<span class="src">Способ устранения: {{ v.remediation.fix_method }}</span>{% endif %}
      <span class="src">Источник: {{ v.remediation.source_label }}</span>
      {% if v.remediation.references %}
      <div class="refs">
        <span class="label">Ссылки на устранение</span>
        <ol>{% for ref in v.remediation.references|links %}<li><b>{{ ref.label }}</b> <a href="{{ ref.url }}">{{ ref.url }}</a></li>{% endfor %}</ol>
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
{% endfor %}
{% endfor %}

<p class="footer-note">Отчёт сформирован по результатам авторизованного тестирования в рамках договора.
Порядок и сроки устранения определяются политикой заказчика.</p>
</body>
</html>
