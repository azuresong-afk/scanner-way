# Узел-сканер (docker-compose.node.yml). Скопируйте в .env.node и заполните.

# Адрес центрального сервера — тот же, что открывают пользователи (только https://).
SCANNER_NODE_SERVER=https://scanner.corp.local
# Токен узла: «Сканеры» → «Добавить узел» (показывается один раз).
SCANNER_NODE_TOKEN=
# Или файл с токеном (вместо переменной): SCANNER_NODE_TOKEN_FILE=/certs/token

# Локальный allowlist узла — сети сегмента, которые этому узлу разрешено
# проверять. Задаётся здесь, на узле, и центром не меняется: адрес вне него узел
# не тронет, даже если центр выдал его в задании. Через запятую: адреса,
# подсети, диапазоны (10.1.0.1-10.1.0.50).
SCANNER_NODE_ALLOWLIST=10.1.0.0/24

# Проверка сертификата центра своим CA (самоподписанный/корпоративный):
# SCANNER_NODE_CA=/certs/ca.crt
# mTLS — сертификат узла для обратного прокси центра (ssl_verify_client):
# SCANNER_NODE_CLIENT_CERT=/certs/node.crt
# SCANNER_NODE_CLIENT_KEY=/certs/node.key

# Опрос центра, с; отметка «жив» во время прогона, с.
# SCANNER_NODE_POLL_SECONDS=5
# SCANNER_NODE_HEARTBEAT_SECONDS=10
# Шаблоны Nuclei из центра раз в сутки (0 — не брать, свои в томе node_nuclei).
# SCANNER_NODE_TEMPLATES_FROM_CENTER=1
# Очередь неотправленных результатов.
# SCANNER_NODE_SPOOL=/var/lib/scanner-node/spool

# Параметры модулей — как в центре (.env.example): SSH, WinRM, SNMP, СУБД.
SCANNER_SSH_KNOWN_HOSTS=/var/lib/scanner-node/ssh_known_hosts
SCANNER_SSH_STRICT_HOST_KEYS=0
SCANNER_WINRM_KNOWN_CERTS=/var/lib/scanner-node/winrm_known_certs
